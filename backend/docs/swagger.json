        "/auth/register/request": {
            "post": {
                "summary": "Request registration invite for a SIT email",
                "operationId": "7fcbe2d9f0804f175cf5fcb4fc8453f0",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "john.doe.2023@sit.singaporetech.edu.sg"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Invite sent"
                    },
                    "400": {
                        "description": "Invalid or non-SIT email"
                    },
                    "429": {
                        "description": "Rate limited"
                    }
                }
            }
        },
        "/auth/register/verify": {
            "get": {
                "summary": "Check invite token validity before showing the form",
                "operationId": "6c507bade7f8308d9e4abf1eb3a81c11",
                "parameters": [
                    {
                        "name": "token",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Token valid — returns masked email"
                    },
                    "400": {
                        "description": "Invalid or expired token"
                    }
                }
            }
        },
        "/auth/register/complete": {
            "post": {
                "summary": "Complete registration using the invite token",
                "operationId": "88ce416dc12ec0f68bc87f2cd78b3943",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "token",
                                    "name",
                                    "password"
                                ],
                                "properties": {
                                    "token": {
                                        "type": "string"
                                    },
                                    "name": {
                                        "type": "string"
                                    },
                                    "password": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Account created, returns access token"
                    },
                    "400": {
                        "description": "Validation or token error"
                    }
                }
            }
        },
